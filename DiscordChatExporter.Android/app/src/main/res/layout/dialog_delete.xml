<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/delete_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pace"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/pace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/pace_gentle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gentle · 1 message every 5 s" />

            <RadioButton
                android:id="@+id/pace_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Normal · 1 message every 2 s" />

            <RadioButton
                android:id="@+id/pace_fast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fast · 1 message every second" />

            <RadioButton
                android:id="@+id/pace_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/custom_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 message every" />

            <EditText
                android:id="@+id/custom_seconds"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:hint="seconds"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:text="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="seconds" />
        </LinearLayout>

        <TextView
            android:id="@+id/estimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="I understand deleted messages can't be restored" />
    </LinearLayout>
</ScrollView>
